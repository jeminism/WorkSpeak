# Environment variables for WorkSpeak Bot

# Slack credentials (from Slack App Settings)
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_SIGNING_SECRET=your-signing-secret
SLACK_APP_TOKEN=xapp-your-app-token

# Your Slack user ID (the bot will only edit your messages)
# Get this from your Slack profile or using: https://api.slack.com/methods/users.list
BOT_USER_ID=U0123456789

# LLM Configuration
# Option 1: Environment variables (highest priority)
LLM_API_KEY=your-openai-api-key
LLM_ENDPOINT=https://api.openai.com/v1/chat/completions
LLM_MODEL=gpt-4o
LLM_PROVIDER=openai

# Option 2: YAML config file (lower priority than env vars)
# LLM_CONFIG_FILE=config/llm_config.yaml

# Logging
WORKSPEAK_LOG_FILE=logs/workSpeak.log
WORKSPEAK_LOG_LEVEL=INFO
